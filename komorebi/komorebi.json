{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.39/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 2,
  "default_container_padding": 2,
  "border": true,
  "border_implementation": "Komorebi",
  "border_style": "System",
  "border_width": 4,
  "border_offset": 0,
  "border_colours": {
    "single": "#d6c870",
    "stack": "#cfc7a2",
    "floating": "#a7d0b6",
    "monocle": "#504700",
    "unfocused": "#959181"
  },
  "mouse_follows_focus": true,
  "transparency": true,
  "transparency_alpha": 230,
  "animation": {
    "enabled": true,
    "duration": 400,
    "fps": 100,
    "style": {
      "movement": "EaseOutBack",
      "transparency": "Linear"
    }
  },
  "stackbar": {
    "height": 24,
    "mode": "Never",
    "label": "Title",
    "tabs": {
      "width": 200,
      "font_size": 16
    }
  },
  "display_index_preferences": {
    "0": "32429",
    "1": "HNAL500308"
  },
  "monitors": [
    {
      "workspaces": [
        { "name": "L1", "layout": "BSP" },
        { "name": "L2", "layout": "BSP" },
        { "name": "L3", "layout": "BSP" },
        { "name": "L4", "layout": "BSP" },
        { "name": "L5", "layout": "BSP" },
        { "name": "L6", "layout": "BSP" },
        { "name": "L7", "layout": "BSP" },
        { "name": "L8", "layout": "BSP" },
        { "name": "L9",
          "layout": "BSP",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "Discord",
              "matching_strategy": "Contains"
            }
          ]
        },
        { "name": "L0",
          "layout": "BSP",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "steamwebhelper.exe",
              "matching_strategy": "Equals"
            }
          ]
        }
      ]
    },
    {
      "workspaces": [
        { "name": "S1", "layout": "BSP" },
        { "name": "S2", "layout": "BSP" },
        { "name": "S3", "layout": "BSP" },
        { "name": "S4", "layout": "BSP" },
        { "name": "S5", "layout": "BSP" },
        { "name": "S6", "layout": "BSP" },
        { "name": "S7", "layout": "BSP" },
        { "name": "S8", "layout": "BSP" },
        { "name": "S9", "layout": "BSP" },
        { "name": "S0", "layout": "BSP" }
      ]
    }
  ]
}
